{
  "name": "@locus/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./control": "./src/control/index.ts",
    "./tenant": "./src/tenant/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate --config drizzle.control.config.ts && drizzle-kit generate --config drizzle.tenant.config.ts && node scripts/embed-migrations.ts",
    "migrate": "node scripts/migrate.ts",
    "test:live": "vitest run src/turso.live.test.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@locus/secrets": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
