{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!packages/skills/catalog",
      "!packages/skills/source",
      "!packages/skills/src/generated",
      "!packages/builder/src/skills/bundle.generated.ts",
      "!.claude/skills/mastra",
      "!.beads",
      "!packages/db/src/control/auth-schema.ts",
      "!packages/db/migrations",
      "!packages/db/src/generated",
      "!packages/agent-api/src/mastra",
      "!apps/web/components/ai-elements",
      "!apps/web/components/chat",
      "!apps/web/components/chat-minimal",
      "!apps/web/components/chat-project",
      "!apps/web/components/ui",
      "!apps/web/lib/agent-controller",
      "!apps/web/lib/mastra-proxy.ts",
      "!apps/web/app/api/agent-controller",
      "!apps/web/app/api/workspace",
      "!apps/web/app/api/browser",
      "!apps/web/app/api/images"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
